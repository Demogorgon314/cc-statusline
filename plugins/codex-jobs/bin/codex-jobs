#!/bin/sh
bin=$(command -v cc-statusline 2>/dev/null) || bin=
if [ -z "$bin" ]; then
    for dir in "${CC_STATUSLINE_BIN_DIR:-}" "$HOME/.local/bin" "$HOME/.cargo/bin"; do
        if [ -n "$dir" ] && [ -x "$dir/cc-statusline" ]; then
            bin=$dir/cc-statusline
            break
        fi
    done
fi
if [ -z "$bin" ]; then
    echo 'Install cc-statusline: curl -fsSL https://raw.githubusercontent.com/Demogorgon314/cc-statusline/main/install.sh | sh' >&2
    exit 127
fi
exec "$bin" codex "$@"
